# Copy this file to .env and fill in ONE option. Never commit .env.

# Option 1: local model with Ollama (free). Install from https://ollama.com, then: ollama pull llama3.1:8b
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Option 2: hosted API (not wired up yet; paste a key into .env only, never into code)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
